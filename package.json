{
  "name": "turborepo-template",
  "version": "0.0.0",
  "description": "A modern TypeScript monorepo template with Turborepo, Vite, React, and comprehensive tooling",
  "private": true,
  "scripts": {
    "prepare": "husky install",
    "dev": "turbo dev",
    "build": "turbo build",
    "clean": "turbo clean",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "type-check": "turbo type-check",
    "format": "turbo format",
    "version": "pnpm changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "cs:finish": "node scripts/cs-commit.js",
    "pub": "node ./build/index.js",
    "notify:lark:dry": "CHANGESET_SOURCE=worktree DRY_RUN=true node scripts/notify-lark.js",
    "notify:lark": "node scripts/notify-lark.js",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "playwright:install": "playwright install",
    "playwright:show-report": "playwright show-report"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": "24.11.1",
    "pnpm": "10.25.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@changesets/cli": "2.29.8",
    "@chromatic-com/storybook": "3.2.7",
    "@commitlint/cli": "20.2.0",
    "@commitlint/config-conventional": "20.2.0",
    "@playwright/test": "1.57.0",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/addon-links": "8.6.14",
    "@storybook/addon-onboarding": "8.6.14",
    "@storybook/addon-viewport": "9.0.8",
    "@storybook/blocks": "8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@storybook/test": "8.6.14",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "25.0.0",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.2.0",
    "autoprefixer": "10.4.22",
    "cross-env": "10.1.0",
    "fast-glob": "3.3.3",
    "husky": "8.0.0",
    "lint-staged": "16.2.7",
    "postcss": "8.5.6",
    "storybook": "8.6.14",
    "tsup": "8.0.0",
    "turbo": "1.13.4",
    "typescript": "5.5.3",
    "vite": "5.0.0",
    "vite-tsconfig-paths": "5.1.4"
  }
}